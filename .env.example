GOOGLE_API_KEY=your-gemini-api-key-here

# Optional model overrides.
# Research needs Google Search grounding, which requires a billed API key.
RESEARCH_MODEL=gemini-flash-latest
ANALYSIS_MODEL=gemini-flash-latest

# Companies House — free. Register an application at
# https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_KEY=

# Adzuna — free tier, a few hundred calls a month.
# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# GDELT needs no key.
